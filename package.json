{
    "name":  "garbacircle",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently \"npm:dev:server\" \"npm:dev:client\"",
                    "dev:server":  "tsx watch server/index.ts",
                    "dev:client":  "vite --host 0.0.0.0",
                    "build":  "tsc -b \u0026\u0026 tsc --project tsconfig.server.json \u0026\u0026 vite build",
                    "start":  "node dist-server/index.js",
                    "seed":  "tsx server/seed.ts"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "connect-mongo":  "^5.1.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^7.5.0",
                         "express-session":  "^1.18.1",
                         "helmet":  "^8.0.0",
                         "lucide-react":  "^0.468.0",
                         "mongoose":  "^8.9.5",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.4",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/express-session":  "^1.18.1",
                            "@types/node":  "^22.10.5",
                            "@types/react":  "^18.3.18",
                            "@types/react-dom":  "^18.3.5",
                            "concurrently":  "^9.1.2",
                            "tsx":  "^4.19.2",
